# Firebase config — সব value Firebase Console > Project Settings থেকে নিন
VITE_FB_API_KEY=           # Project Settings > Web API key
VITE_FB_AUTH_DOMAIN=       # yourproject.firebaseapp.com
VITE_FB_DATABASE_URL=      # https://yourproject-default-rtdb.firebaseio.com
VITE_FB_PROJECT_ID=        # yourproject
VITE_FB_DB_SECRET=         # (optional, old method)

# FCM Legacy Server Key — Firebase Console > Project Settings > Cloud Messaging > Server Key
# এই key দিয়ে সরাসরি FCM push notification পাঠানো হয় — GAS লাগে না
VITE_FCM_SERVER_KEY=       # AAAAxxxxx... (Cloud Messaging tab এ পাবে)

# ImgBB API Key
VITE_IMGBB_API_KEY=

# ── নিচেরগুলো আর দরকার নেই (GAS app থেকে remove হয়েছে) ──
# VITE_GAS_URL=            # GAS এখন standalone — app এ লাগে না
# VITE_SECRET_KEY=         # GAS secret — app এ লাগে না
